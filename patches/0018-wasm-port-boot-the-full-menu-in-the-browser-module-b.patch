+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+EM_JS(void, wc3_page_play_movie, (const char *path), {
+    if (Module.wc3PlayMovie) Module.wc3PlayMovie(UTF8ToString(path));
+});
+EMSCRIPTEN_KEEPALIVE void WC3_MovieDone(void) {
+    cl_movie.active = false;
+}
+#endif
+
 bool CL_PlayMovie(cstring_t path) {
-#ifndef BZ_FFMPEG
+#ifdef __EMSCRIPTEN__
+    /* Browser: the page owns decoding (a fullscreen <video> overlay); the engine
+     * keeps the movie-active gate until WC3_MovieDone comes back from the page. */
+    if (!path || !*path) return false;
+    memset(&cl_movie, 0, sizeof(cl_movie));
+    snprintf(cl_movie.source_path, sizeof(cl_movie.source_path), "%s", path);
+    cl_movie.active = true;
+    wc3_page_play_movie(path);
+    return true;
+#elif !defined(BZ_FFMPEG)
     CON_printf("Skipping movie %s: playback is disabled in this build (rebuild with FFMPEG=1).", path ? path : "");
     return false;
