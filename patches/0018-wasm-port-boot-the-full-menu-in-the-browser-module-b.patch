     if (!CL_GameplayInputReady() || CL_MouseOverGameplayUI()) return;
     input.look = true; input.travel = (vec2_t){0};
+#ifndef __EMSCRIPTEN__
+    /* Browser builds: SDL relative mode maps to pointer lock, which hijacks the
