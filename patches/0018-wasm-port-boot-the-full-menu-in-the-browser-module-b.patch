-/* FDF host services — game module implementations using gi */
-BZ_HOST_HIDDEN handle_t UI_FdfAlloc(long size) { return gi.MemAlloc(size); }
-BZ_HOST_HIDDEN void UI_FdfFree(handle_t ptr) { gi.MemFree(ptr); }
+/* FDF host services — game module implementations using gi.  During a
+ * client-only boot (menu phase, no map) the gi table is unfilled, so fall
+ * back to the engine-level services directly — in the wasm single-image
+ * build every module shares one address space and the linker may bind the
+ * plain symbols here; the fallback keeps both contexts working. */
+BZ_HOST_HIDDEN handle_t UI_FdfAlloc(long size) {
+    if (gi.MemAlloc) return gi.MemAlloc(size);
+    return MemAlloc((size_t)size);
+}
+BZ_HOST_HIDDEN void UI_FdfFree(handle_t ptr) {
+    if (gi.MemFree) { gi.MemFree(ptr); return; }
+    MemFree(ptr);
+}
 BZ_HOST_HIDDEN int UI_FdfReadFile(cstring_t name, handle_t *out) {
-    uint32_t size = 0;
-    *out = gi.ReadFile(name, &size);
-    return *out ? (int)size : -1;
+    if (gi.ReadFile) {
+        uint32_t size = 0;
+        *out = gi.ReadFile(name, &size);
+        return *out ? (int)size : -1;
+    }
+    return FS_ReadFileQ3(name, (void **)out);
+}
+BZ_HOST_HIDDEN void UI_FdfFreeFile(handle_t buf) {
+    if (gi.MemFree) { gi.MemFree(buf); return; }
+    MemFree(buf);
 }
-BZ_HOST_HIDDEN void UI_FdfFreeFile(handle_t buf) { gi.MemFree(buf); }
 
 /* Game module doesn't handle UI events or themes — stub these */
 BZ_HOST_HIDDEN void UI_WireFrameTypeFunctions(frameDef_t *frame) { (void)frame; }
@@ -868,5 +884,10 @@ BZ_HOST_HIDDEN void UI_ClearTheme(void) {}
 
 /* Game module doesn't load 3D models for UI — stub */
 BZ_HOST_HIDDEN uint32_t UI_LoadModel(cstring_t file, bool decorate) {
-    return file && *file ? gi.ModelIndex(decorate ? Theme_PlayerString(NULL, file, file) : file) : 0;
+    if (!file || !*file) return 0;
+    if (!gi.ModelIndex) {
+        /* client-only boot (menu): the server-owned model table is not up yet. */
+        return 0;
+    }
+    return gi.ModelIndex(decorate ? Theme_PlayerString(NULL, file, file) : file);
 }
