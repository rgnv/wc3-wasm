 bool SV_LobbyClientIsHost(client_t *client) {
+    /* Dedicated servers keep an internal loopback client from their boot map;
+     * it is not a player and must not consume the lobby host role. */
+    bool const dedicated = Cvar_Integer("dedicated", 0) != 0;
+
     FOR_LOOP(i, svs.num_clients) {
         client_t *cl = &svs.clients[i];
 
-        if (cl->state == cs_connected || cl->state == cs_spawned) {
-            return cl == client;
+        if (cl->state != cs_connected && cl->state != cs_spawned) {
+            continue;
+        }
+        if (dedicated && cl->netchan.remote_address.type == NA_LOOPBACK) {
+            continue;
         }
+        return cl == client;
     }
     return false;
 }
