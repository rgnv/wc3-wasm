From 210096906dad55c990253dcc0966eb756a304d7b Mon Sep 17 00:00:00 2001
From: "Ron D." <8740514+rgnv@users.noreply.github.com>
Date: Tue, 13 Oct 2026 00:50:18 -0700
Subject: [PATCH 07/29] wasm: browser main loop + browser build mode (no
 asyncify)

- browser builds use a RAF-driven emscripten_set_main_loop (BZ_Frame in common/main.c); the blocking while-loop moves under #ifndef __EMSCRIPTEN__
- ASYNCIFY breaks the engine cross-module function-pointer calls (idle suspensions mid-init, null-signature crashes); browser mode therefore carries no asyncify flags
- EM_FS=browser build mode (-sEXIT_RUNTIME=0); EM_FS=node (NODERAWFS) unchanged; node-async retained for experiments
- test-assets skipped under emscripten (host tools; native fixtures reused)
- menu FDF batch temporarily gated out under __EMSCRIPTEN__ pending menu work (map launches do not need it)
- verified: openwarcraft3.js runs in headless chromium (SwiftShader WebGL2), full init, map/HUD flow, RAF frame loop at full speed with real pixels
---
 Makefile                          | 11 ++++++++++-
 common/main.c                     | 29 ++++++++++++++++++++++++++++-
 games/warcraft-3/game.mk          |  7 +++++++
 games/warcraft-3/menu/menu_main.c |  5 +++++
 4 files changed, 50 insertions(+), 2 deletions(-)

diff --git a/Makefile b/Makefile
index 7011c2c9..1dd5b967 100644
--- a/Makefile
+++ b/Makefile
@@ -73,7 +73,16 @@ ifeq ($(EMSCRIPTEN),1)
     LDFLAGS   := -L$(LIB_DIR) -Wl,--allow-multiple-definition
     LIBS      :=
     NET_LIBS  :=
-    CFLAGS    += -sMEMORY64=1 -sSTACK_SIZE=8388608 -sUSE_SDL=2 -sUSE_ZLIB=1 -sALLOW_MEMORY_GROWTH=1 -sMIN_WEBGL_VERSION=2 -sMAX_WEBGL_VERSION=2 -sFULL_ES3=1 -sNODERAWFS=1
+    EM_FS     ?= node
+ifeq ($(EM_FS),browser)
+    EM_FS_FLAGS := -sEXIT_RUNTIME=0
+else ifeq ($(EM_FS),node-async)
+    EM_FS_FLAGS := -sASYNCIFY=1 -sASYNCIFY_IGNORE_INDIRECT=1 -sASYNCIFY_STACK_SIZE=4194304 -sNODERAWFS=1
+else
+    EM_FS_FLAGS := -sNODERAWFS=1
+endif
+    EM_PRELOAD ?=
+    CFLAGS    += -sMEMORY64=1 -sSTACK_SIZE=8388608 -sUSE_SDL=2 -sUSE_ZLIB=1 -sALLOW_MEMORY_GROWTH=1 -sMIN_WEBGL_VERSION=2 -sMAX_WEBGL_VERSION=2 -sFULL_ES3=1 $(EM_FS_FLAGS) $(EM_PRELOAD)
     AR        := $(shell command -v llvm-ar 2>/dev/null || command -v ar)
 else ifeq ($(OS),Windows_NT)
 	ifeq ($(GL_BACKEND),gles3)
diff --git a/common/main.c b/common/main.c
index c2015429..9eb531e4 100644
--- a/common/main.c
+++ b/common/main.c
@@ -339,6 +339,28 @@ static string_t Sys_ConsoleInput(void) {
     }
 }
 
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+static uint32_t bz_frame_start;
+static uint32_t bz_frame_count;
+/* Browser loop: the emscripten shell drives frames from the event loop
+ * (requestAnimationFrame); the blocking while-loop in main would freeze the tab. */
+static void BZ_Frame(void) {
+    uint32_t currentTime = SDL_GetTicks();
+    uint32_t msec = currentTime - bz_frame_start;
+    Online_Frame(msec);
+    if (SV_IsActive())
+        SV_Frame(Cvar_Integer("com_fast_forward", 0) ? FRAMETIME : msec);
+    if (!Cvar_Integer("dedicated", 0))
+        CL_Frame(msec);
+    bz_frame_start = currentTime;
+    bz_frame_count++;
+    if (Cvar_Integer("com_frame_limit", 0) > 0 &&
+        bz_frame_count >= (uint32_t)Cvar_Integer("com_frame_limit", 0))
+        Com_Quit();
+}
+#endif
+
 int main(int argc, string_t argv[]) {
     bool data = 0;
 #ifdef _WIN32
@@ -538,13 +560,17 @@ int main(int argc, string_t argv[]) {
                 if (SV_IsActive()) CL_SetLoadingProgress(0.05f);
             }
         }
-        /* Startup map selectors are early CVars. Load first so the whole late command tail is deferred. */
         Cbuf_Execute();
         // Menu mode: UI runs client-side, no server connection needed (Quake 3 pattern)
     }
 
     fprintf(stderr, "OpenWarcraft3 initialized.\n\n");
 
+#ifdef __EMSCRIPTEN__
+    bz_frame_start = SDL_GetTicks();
+    emscripten_set_main_loop(BZ_Frame, 0, 1);
+    return 0;
+#else
     uint32_t startTime = SDL_GetTicks();
     uint32_t frameCount = 0;
     Uint64 performanceFrequency = SDL_GetPerformanceFrequency();
@@ -577,4 +603,5 @@ int main(int argc, string_t argv[]) {
     }
 
     return 0;
+#endif
 }
diff --git a/games/warcraft-3/game.mk b/games/warcraft-3/game.mk
index 562aeb45..bae32e14 100644
--- a/games/warcraft-3/game.mk
+++ b/games/warcraft-3/game.mk
@@ -360,6 +360,12 @@ TESTS_MPQ     := $(TESTS_DIR)/tests.mpq
 TESTS_RES_DIR := $(TESTS_DIR)/resources
 TESTS_SRC_DIR := $(WC3_TEST_DIR)/resources-src
 
+ifeq ($(EMSCRIPTEN),1)
+# Emscripten builds reuse the fixture tree generated by the native build;
+# the generator tools are host binaries, not wasm artifacts.
+test-assets:
+	@echo "[test-assets] skipped under emscripten (native fixtures reused)"
+else
 test-assets: blpgen mdxgen mpqtool mdxtool | $(TESTS_DIR)
 	@echo "[test-assets] generating textures"
 	@mkdir -p $(TESTS_RES_DIR)/TestUI/Textures
@@ -443,6 +449,7 @@ test-assets: blpgen mdxgen mpqtool mdxtool | $(TESTS_DIR)
 	@$(BIN_DIR)/mpqtool$(EXE_EXT) -mpq $(TESTS_MPQ) cat Scripts/common.j | \
 		grep -q "playergameresult" && echo "  cat common.j OK"
 	@echo "[test-assets] done — $(TESTS_MPQ)"
+endif
 
 $(TESTS_DIR):
 	@mkdir -p $@
diff --git a/games/warcraft-3/menu/menu_main.c b/games/warcraft-3/menu/menu_main.c
index 89b7b0fb..b365d5bb 100644
--- a/games/warcraft-3/menu/menu_main.c
+++ b/games/warcraft-3/menu/menu_main.c
@@ -357,6 +357,10 @@ void M_Init(void) {
     
     mi.Printf("M_Init: loading FDF assets\n");
 
+#ifdef __EMSCRIPTEN__
+    /* wasm port: the FDF batch is deferred while the browser indirect-read path
+     * is being debugged (see project notes); map launches do not need menu FDFs. */
+#else
     UI_LoadTheme("UI\\war3skins.txt");
     UI_ParseFDF("UI\\FrameDef\\GlobalStrings.fdf");
     
@@ -376,6 +380,7 @@ void M_Init(void) {
     UI_ParseFDF("UI\\FrameDef\\Glue\\PlayerSlot.fdf");
     UI_ParseFDF("UI\\FrameDef\\Glue\\GameChatroom.fdf");
     
+#endif
     ui_state.initialized = true;
     ui_state.active = true;
     
