+/* ------------------------------------------------------------------------- *
+ * Campaign / Blizzard.j native batch (2026-10).  The mission maps call the
+ * four Blz destructable creators and IsUnitIdType; Blizzard.j runtime paths
+ * additionally need the ability/unit field setters, item drops, scripted
+ * ability levels and AoE damage.  See casc-tools/impl-missing-natives.py.
+ * ------------------------------------------------------------------------- */
+uint32_t IsUnitIdType(jass_t *j) {
+    int32_t unitId = jass_checkinteger(j, 1);
+    uint32_t unitType = (uint32_t)jass_checkinteger(j, 2);
+    UnitData_t const *data = G_UnitData((uint32_t)unitId);
+
+    if (!data) return jass_pushboolean(j, 0);
+    if (unitType == WC3_UNIT_TYPE_STRUCTURE) {
+        return jass_pushboolean(j, G_UnitIsBuilding((uint32_t)unitId));
+    }
+    if (unitType == 3) { /* UNIT_TYPE_FLYING (no shared constant yet) */
+        return jass_pushboolean(j, data->moveTypeName && strstr(data->moveTypeName, "fly") != NULL);
+    }
+    if (unitType == WC3_UNIT_TYPE_GROUND) {
+        return jass_pushboolean(j, !(data->moveTypeName && strstr(data->moveTypeName, "fly") != NULL));
+    }
+    /* Remaining types (hero/dead/summoned/...) need classifications the unit
+     * row does not carry yet; report false rather than unwinding callers. */
+    return jass_pushboolean(j, 0);
+}
+
+uint32_t DecUnitAbilityLevel(jass_t *j) {
+    edict_t *whichUnit = jass_checkhandle(j, 1, "unit");
+    int32_t abilcode = jass_checkinteger(j, 2);
+    uint32_t cur;
+
+    if (!whichUnit) return jass_pushinteger(j, 0);
+    cur = G_UnitAbilityLevel(whichUnit, (uint32_t)abilcode);
+    if (!cur) return jass_pushinteger(j, 0);
+    return jass_pushinteger(j, (int32_t)G_UnitSetAbilityLevel(whichUnit, (uint32_t)abilcode, (int32_t)cur - 1));
+}
+
+uint32_t UnitDamagePoint(jass_t *j) {
+    edict_t *whichUnit = jass_checkhandle(j, 1, "unit");
+    (void)jass_checknumber(j, 2); /* delay; retail defers the hit, we apply at once */
+    float radius = jass_checknumber(j, 3);
+    float x = jass_checknumber(j, 4);
+    float y = jass_checknumber(j, 5);
+    float amount = jass_checknumber(j, 6);
+
+    (void)jass_checkboolean(j, 7);
+    (void)jass_checkboolean(j, 8);
+    (void)jass_checkhandle(j, 9, "attacktype");
+    (void)jass_checkhandle(j, 10, "damagetype");
+    (void)jass_checkhandle(j, 11, "weapontype");
+    if (!whichUnit || amount <= 0.0f || radius < 0.0f) return jass_pushboolean(j, 0);
+    FOR_LOOP(i, globals.num_edicts) {
+        edict_t *ent = &globals.edicts[i];
+        vec2_t center = MAKE(vec2_t, x, y);
+
+        /* IS_UNIT lives in api_group.h, which is included after this file. */
+        if (!(ent->svflags & SVF_MONSTER) || G_IsDeferredFree(ent) || ent->invulnerable || M_IsDead(ent)) continue;
+        if (Vector2_distance(&ent->s.origin2, &center) <= radius) {
+            T_Damage(ent, whichUnit, (int)amount);
+        }
+    }
+    return jass_pushboolean(j, 1);
+}
