+static bool W3TownHallClass(uint32_t id) {
+    return id == MAKEFOURCC('h','t','o','w') || id == MAKEFOURCC('h','k','e','e') || id == MAKEFOURCC('h','c','a','s') ||
+           id == MAKEFOURCC('o','t','o','w') || id == MAKEFOURCC('o','s','t','w') || id == MAKEFOURCC('o','f','r','t') ||
+           id == MAKEFOURCC('u','n','p','l') || id == MAKEFOURCC('u','n','p','c') || id == MAKEFOURCC('u','n','p','1') || id == MAKEFOURCC('u','n','p','2') ||
+           id == MAKEFOURCC('e','t','o','l') || id == MAKEFOURCC('e','t','o','e') || id == MAKEFOURCC('e','t','o','a');
+}
+uint32_t BlzGetPlayerTownHallCount(jass_t *j) {
+    player_t *player = jass_checkhandle(j, 1, "player");
+    int32_t count = 0;
+    if (player) {
+        int32_t const pnum = PLAYER_NUM(player);
+        for (edict_t *ent = globals.edicts; ent - globals.edicts < globals.num_edicts; ent++) {
+            if (!ent->inuse || ent->s.player != (uint32_t)pnum || !G_UnitIsStructure(ent)) continue;
+            if (W3TownHallClass(ent->class_id)) count++;
+        }
+    }
+    return jass_pushinteger(j, count);
+}
