+
+/* The 1.32+ data drops the UnitUI "file" column; unit models resolve from the
+ * retail tree layout instead — units/<race>/<name>/<name>.mdx, structures under
+ * buildings/... . Rows that already carry an authored path are left alone. */
+static bool G_MapModelExists(cstring_t path) {
+    uint32_t size = 0;
+    handle_t data = gi.ReadFile(path, &size);
+    if (!data) return false;
+    gi.MemFree(data);
+    return true;
+}
+
+static void G_ResolveUnitModelPaths(void) {
+    FOR_LOOP(i, g_UnitUICount) {
+        UnitUI_t *ui = &g_UnitUI[i];
+        UnitData_t const *data;
+        PATHSTR path;
+        bool building;
+
+        if (ui->modelFile && *ui->modelFile) continue;
+        if (!ui->name || !*ui->name) continue;
+        data = G_UnitData(ui->id);
+        if (!data || !data->race || !*data->race) continue;
+        building = G_UnitIsBuilding(ui->id);
+        snprintf(path, sizeof(path), "%s\\%s\\%s\\%s.mdx",
+                 building ? "buildings" : "units", data->race, ui->name, ui->name);
+        if (!G_MapModelExists(path))
+            snprintf(path, sizeof(path), "%s\\%s\\%s\\%s.mdx",
+                     building ? "units" : "buildings", data->race, ui->name, ui->name);
+        if (!G_MapModelExists(path))
+            snprintf(path, sizeof(path), "%s\\%s\\%.4s\\%.4s.mdx",
+                     building ? "buildings" : "units", data->race,
+                     (char const *)&ui->id, (char const *)&ui->id);
+        if (!G_MapModelExists(path)) continue;
+        ui->modelFile = strdup(path);
+    }
+}
