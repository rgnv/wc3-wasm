From e568bafa1650298175e274caf46b78a635cfaa8a Mon Sep 17 00:00:00 2001
From: "Ron D." <8740514+rgnv@users.noreply.github.com>
Date: Wed, 14 Oct 2026 18:40:01 -0700
Subject: [PATCH 25/29] tools: dedicated lobby variant for custom/TFT maps

---
 tools/ws-bridge/run-dedicated-custom.sh | 27 +++++++++++++++++++++++++
 1 file changed, 27 insertions(+)
 create mode 100755 tools/ws-bridge/run-dedicated-custom.sh

diff --git a/tools/ws-bridge/run-dedicated-custom.sh b/tools/ws-bridge/run-dedicated-custom.sh
new file mode 100755
index 00000000..50199951
--- /dev/null
+++ b/tools/ws-bridge/run-dedicated-custom.sh
@@ -0,0 +1,27 @@
+#!/usr/bin/env bash
+# Dedicated lobby for the browser-host start test: real data, bootybay,
+# NO timer startmatch - the browser lobby host presses Start.
+# Config FIRST (slot_count gates the slot commands), then the slot block.
+{
+  sleep 75
+  echo 'lobby_start Maps/frozenthrone/(2)banditridge.w3x'
+  echo 'lobby_config 2 12 Maps/frozenthrone/(2)banditridge.w3x'
+  sleep 2
+  while IFS= read -r wc3line; do
+    echo "$wc3line"
+    sleep 0.5
+  done <<'SLOTS'
+lobby_slot 1 1 1 0 0 1 1 Open
+lobby_slot 2 1 2 0 0 1 2 Open
+lobby_slot 3 1 3 0 0 1 3 Open
+lobby_slot 4 1 4 0 0 1 4 Open
+lobby_slot 5 1 5 0 0 1 5 Open
+lobby_slot 6 1 6 0 0 1 6 Open
+lobby_slot 7 1 7 0 0 1 7 Open
+lobby_slot 8 1 8 0 0 1 8 Open
+lobby_slot 9 1 9 0 0 1 9 Open
+lobby_slot 10 1 10 0 0 1 10 Open
+lobby_slot 11 1 11 0 0 1 11 Open
+SLOTS
+  sleep 86400
+} | exec ./build/bin/openwarcraft3 -data /src/gamedata/engine +dedicated 1 +game_port 27960 +map 'Maps/frozenthrone/(2)banditridge.w3x'
