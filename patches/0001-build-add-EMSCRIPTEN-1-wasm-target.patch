From 8fe019c9231398692a67a6ee24a837f2d8a6707e Mon Sep 17 00:00:00 2001
From: "Ron D." <8740514+rgnv@users.noreply.github.com>
Date: Mon, 12 Oct 2026 22:59:39 -0700
Subject: [PATCH 01/29] build: add EMSCRIPTEN=1 wasm target

- new platform branch: CC=emcc, .a static module archives, .js executables, no RPATH/-z defs, SDL2+zlib via emscripten ports
- unity/src lib schemas archive objects with $(AR) instead of linking shared libs
- font header expected pre-generated by the host build (img2sysfont is a host tool)
---
 Makefile | 49 +++++++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 47 insertions(+), 2 deletions(-)

diff --git a/Makefile b/Makefile
index 2990175c..1ccbf848 100644
--- a/Makefile
+++ b/Makefile
@@ -61,7 +61,21 @@ endif
 # ---------------------------------------------------------------------------
 # Platform detection
 # ---------------------------------------------------------------------------
-ifeq ($(OS),Windows_NT)
+ifeq ($(EMSCRIPTEN),1)
+    # Emscripten wasm build: static archives, SDL2/zlib ports, no shared libs/RPATH.
+    CC        := emcc
+    LIB_EXT   := .a
+    LIB_FLAGS :=
+    EXE_EXT   := .js
+    INSTALL_NAME =
+    RPATH     :=
+    LIB_RPATH :=
+    LDFLAGS   := -L$(LIB_DIR)
+    LIBS      :=
+    NET_LIBS  :=
+    CFLAGS    += -sUSE_SDL=2 -sUSE_ZLIB=1 -sALLOW_MEMORY_GROWTH=1
+    AR        := $(shell command -v llvm-ar 2>/dev/null || command -v ar)
+else ifeq ($(OS),Windows_NT)
 	ifeq ($(GL_BACKEND),gles3)
 		$(error GL_BACKEND=gles3 is currently supported on Linux only)
 	endif
@@ -203,6 +217,30 @@ $(1): $(2) $$(SERVER_HEADERS) | $$(BIN_DIR) install-share
 		$$(CC) $(4) -x c -o $$@ - $$(RPATH) $$(LDFLAGS) $(5)
 endef
 
+ifeq ($(EMSCRIPTEN),1)
+# Emscripten variants: modules are archived into static .a files (side modules
+# would need runtime dlopen; a single-step static link keeps the wasm build simple).
+define unity_lib_schema
+$(1): $(2) $$(SERVER_HEADERS) | $$(LIB_DIR)
+	@echo "[$(3)]"
+	@$$(call UNITY,$$(4),$(5)) | \
+		$$(CC) $(6) -x c -c -o $(basename $(1)).o -
+	@for extra in $(7); do \
+		$$(CC) $(6) -c -o "$(LIB_DIR)/obj-$(3)-$${extra##*/}.o" "$$extra" || exit 1; \
+	done
+	@$$(AR) rcs $$@ $(basename $(1)).o $(foreach e,$(7),$(LIB_DIR)/obj-$(3)-$(notdir $e).o)
+endef
+
+define src_lib_schema
+$(1): $(2) $$(SERVER_HEADERS) | $$(LIB_DIR)
+	@echo "[$(3)]"
+	@for f in $(5); do \
+		$$(CC) $(4) -c -o "$(LIB_DIR)/obj-$(3)-$${f##*/}.o" "$$f" || exit 1; \
+	done
+	@$$(AR) rcs $$@ $(foreach f,$(5),$(LIB_DIR)/obj-$(3)-$(notdir $f).o)
+endef
+endif
+
 define test_schema
 
 $(4): $(2) $(5) $$(SERVER_HEADERS) | $$(BIN_DIR)
@@ -276,8 +314,15 @@ $(BIN_DIR)/imgdiff$(EXE_EXT): tools/imgdiff.c renderer/stb/stb_image.h renderer/
 	@echo "[imgdiff]"
 	@$(CC) $(CFLAGS) -o $@ tools/imgdiff.c -lm
 
+ifeq ($(EMSCRIPTEN),1)
+# The font tool is a host binary; wasm builds expect the header pre-generated
+# by the native build.
+$(FONT_HEADER):
+	@test -f $@ || { echo "missing $@ - generate with the native build first" >&2; exit 1; }
+else
 $(FONT_HEADER): $(FONT_SRC) $(BIN_DIR)/img2sysfont$(EXE_EXT)
-	@$(BIN_DIR)/img2sysfont$(EXE_EXT) $(FONT_SRC) $(FONT_HEADER) $(FONT_SYMBOL)
+	$(BIN_DIR)/img2sysfont$(EXE_EXT) $(FONT_SRC) $(FONT_HEADER) $(FONT_SYMBOL)
+endif
 
 clean:
 	rm -rf build
