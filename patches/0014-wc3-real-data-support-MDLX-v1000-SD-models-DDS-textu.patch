index 00000000..da3a71a6
--- /dev/null
+++ b/tools/casc/README.md
@@ -0,0 +1,41 @@
+# WC3 CASC → MPQ data tools (rgnv fork, wasm-port)
+
+Prep tools for turning the modern WC3 CASC install into engine-readable MPQ sets.
+
+## Build
+
+```bash
+# deps (Debian): zlib1g-dev libtomcrypt-dev libtommath-dev libbz2-dev cmake g++
+git clone --depth 1 https://github.com/ladislav-zezula/CascLib.git
+git clone --depth 1 https://github.com/ladislav-zezula/StormLib.git
+# CascLib current master needs a one-line Linux fix: s/LPDWORD/PDWORD/ in src/CascFiles.cpp
+cmake -B CascLib/build -S CascLib -DCMAKE_BUILD_TYPE=Release && cmake --build CascLib/build -j
+cmake -B StormLib/build -S StormLib -DCMAKE_BUILD_TYPE=Release && cmake --build StormLib/build -j
+
+g++ -O2 -std=c++17 wc3casc.cpp -I CascLib/src  -L CascLib/build  -lcasc -o wc3casc
+g++ -O2 -std=c++17 wc3mpq.cpp  -I StormLib/src -L StormLib/build -lstorm -ltomcrypt -ltommath -lbz2 -lz -o wc3mpq
+```
+
+## wc3casc — read/extract from the CASC tree
+
+```
+wc3casc list <tree> [outListFile]           # enumerate (writes <size>	<name> lines)
+wc3casc extract <tree> <name> <outFile>
+wc3casc extract-list <tree> <nameFile> <outDir>   # batch; names mapped ':'/'' -> '/'
+```
+
+- `tree` = the install dir containing `.build.info` (your Warcraft III installation).
+- Names use the `war3.w3mod:<path>` virtual-prefix scheme (backslashes).
+- Classic SD set = plain `war3.w3mod:` root + `_locales\<lang>.w3mod:` + `_tilesets\<letter>.w3mod:`.
+
+## wc3mpq — bulk-pack an MPQ from a manifest
+
+```
+wc3mpq <archive.mpq> <manifest.tsv>          # lines: <src-path>	<archive-name>
+```
+
+- **PITFALL: MPQ v1 archives cap at 4 GiB.** Keep each archive under it (e.g. ship the
+  `movies/` tree as its own `War3Movies.mpq`; the engine mounts every `*.mpq` found in
+  the data dir, so splitting is free).
+- Engine archive contract: `war3.mpq` (+ `War3Local.mpq`), per-tileset `A..Z.mpq`
+  (uppercase letter = the map's tileset byte, `R_W3OpenTilesetArchive`).
diff --git a/tools/casc/wc3casc.cpp b/tools/casc/wc3casc.cpp
new file mode 100644
index 00000000..5f74507d
--- /dev/null
+++ b/tools/casc/wc3casc.cpp
@@ -0,0 +1,146 @@
+// wc3casc — minimal CascLib CLI for extracting Warcraft III (Reforged) CASC storages.
+// modes:
+//   list        <storage> <outListFile>
+//   extract     <storage> <name> <outFile>
+//   extract-mask<storage> <mask> <outDir>       (names 'war3.mpq:a/b' -> outDir/war3.mpq/a/b)
+// Built against CascLib (ladislav-zezula), local build in ../CascLib/build.
+#include <cstdio>
+#include <cstring>
+#include <cstdlib>
+#include <string>
+#include <sys/stat.h>
+#include "CascLib.h"
+
+static void mkdirs(const std::string &path) {
+    std::string cur;
+    for (char c : path) {
+        cur += c;
+        if (c == '/') mkdir(cur.c_str(), 0755);
+    }
+    mkdir(path.c_str(), 0755);
+}
+
+static std::string nameToPath(const std::string &name) {
+    std::string out;
+    out.reserve(name.size());
+    for (char c : name) out += (c == ':' || c == '\\') ? '/' : c;
+    return out;
+}
+
+static bool writeFile(HANDLE storage, const char *name, const std::string &dest, unsigned long long *bytesOut) {
+    HANDLE f = NULL;
+    if (!CascOpenFile(storage, name, 0, CASC_OPEN_BY_NAME, &f)) return false;
+    size_t slash = dest.find_last_of('/');
+    if (slash != std::string::npos) mkdirs(dest.substr(0, slash));
+    FILE *out = fopen(dest.c_str(), "wb");
+    if (!out) { CascCloseFile(f); return false; }
+    char buf[0x10000];
+    DWORD got = 0;
+    unsigned long long total = 0;
+    for (;;) {
+        if (!CascReadFile(f, buf, sizeof(buf), &got) || got == 0) break;
+        fwrite(buf, 1, got, out);
+        total += got;
+    }
+    fclose(out);
+    CascCloseFile(f);
+    if (bytesOut) *bytesOut = total;
+    return true;
+}
+
+int main(int argc, char **argv) {
+    if (argc < 3) {
+        fprintf(stderr, "usage:\n  %s list <storage> [outListFile]\n  %s extract <storage> <name> <outFile>\n  %s extract-mask <storage> <mask> <outDir>\n",
+                argv[0], argv[0], argv[0]);
+        return 2;
+    }
+    const char *mode = argv[1];
+    HANDLE storage = NULL;
+    if (!CascOpenStorage(argv[2], 0, &storage)) {
+        fprintf(stderr, "CascOpenStorage(%s) failed: err=%u\n", argv[2], GetCascError());
+        return 1;
+    }
+    printf("storage opened: %s\n", argv[2]);
+
+    if (!strcmp(mode, "list")) {
+        const char *outList = (argc > 3) ? argv[3] : "casc-list.txt";
+        FILE *lf = fopen(outList, "w");
+        CASC_FIND_DATA fd;
+        memset(&fd, 0, sizeof(fd));
+        HANDLE h = CascFindFirstFile(storage, "*", &fd, NULL);
+        long long n = 0;
+        if (h && h != INVALID_HANDLE_VALUE) {
+            do {
+                n++;
+                if (lf) fprintf(lf, "%llu\t%s\n", (unsigned long long)fd.FileSize, fd.szFileName);
+                if (n <= 30) printf("  %s\n", fd.szFileName);
+            } while (CascFindNextFile(h, &fd));
+            CascFindClose(h);
+        } else {
+            fprintf(stderr, "find failed err=%u\n", GetCascError());
+        }
+        if (lf) fclose(lf);
+        printf("total files: %lld (list written to %s)\n", n, outList);
+    } else if (!strcmp(mode, "extract")) {
+        if (argc < 5) { fprintf(stderr, "extract needs <storage> <name> <outFile>\n"); return 2; }
+        unsigned long long total = 0;
+        if (!writeFile(storage, argv[3], argv[4], &total)) {
+            fprintf(stderr, "extract failed for %s (err=%u)\n", argv[3], GetCascError());
+            return 1;
+        }
+        printf("extracted %s -> %s (%llu bytes)\n", argv[3], argv[4], total);
+    } else if (!strcmp(mode, "extract-mask")) {
+        if (argc < 5) { fprintf(stderr, "extract-mask needs <storage> <mask> <outDir>\n"); return 2; }
+        std::string outDir = argv[4];
+        CASC_FIND_DATA fd;
+        memset(&fd, 0, sizeof(fd));
+        HANDLE h = CascFindFirstFile(storage, argv[3], &fd, NULL);
+        long long ok = 0, fail = 0;
+        if (h && h != INVALID_HANDLE_VALUE) {
+            do {
+                std::string dest = outDir + "/" + nameToPath(fd.szFileName);
+                unsigned long long total = 0;
+                if (writeFile(storage, fd.szFileName, dest, &total)) {
+                    ok++;
+                    if (ok % 500 == 0) printf("  ... %lld files\n", ok);
+                } else {
+                    fail++;
+                    if (fail <= 20) fprintf(stderr, "  FAIL(%u): %s\n", GetCascError(), fd.szFileName);
+                }
+            } while (CascFindNextFile(h, &fd));
+            CascFindClose(h);
+        } else {
+            fprintf(stderr, "find failed err=%u\n", GetCascError());
+        }
+        printf("extract-mask done: ok=%lld fail=%lld -> %s\n", ok, fail, argv[4]);
+    } else if (!strcmp(mode, "extract-list")) {
+        if (argc < 5) { fprintf(stderr, "extract-list needs <storage> <nameFile> <outDir>\n"); return 2; }
+        std::string outDir = argv[4];
+        FILE *nl = fopen(argv[3], "r");
+        if (!nl) { fprintf(stderr, "cannot open %s\n", argv[3]); return 2; }
+        char line[4096];
+        long long ok = 0, fail = 0;
+        while (fgets(line, sizeof(line), nl)) {
+            size_t len = strlen(line);
+            while (len && (line[len - 1] == '\n' || line[len - 1] == '\r')) line[--len] = 0;
+            if (!len) continue;
+            std::string dest = outDir + "/" + nameToPath(line);
+            unsigned long long total = 0;
+            if (writeFile(storage, line, dest, &total)) {
+                ok++;
+                if (ok % 1000 == 0) printf("  ... %lld files\n", ok);
+            } else {
+                fail++;
+                if (fail <= 30) fprintf(stderr, "  FAIL(%u): %s\n", GetCascError(), line);
+            }
+        }
+        fclose(nl);
+        printf("extract-list done: ok=%lld fail=%lld -> %s\n", ok, fail, argv[4]);
+    } else {
+        fprintf(stderr, "unknown mode %s\n", mode);
+        return 2;
+    }
+
+    CascCloseStorage(storage);
+    return 0;
+}
diff --git a/tools/casc/wc3mpq.cpp b/tools/casc/wc3mpq.cpp
new file mode 100644
index 00000000..7257491f
--- /dev/null
+++ b/tools/casc/wc3mpq.cpp
@@ -0,0 +1,70 @@
+// wc3mpq — bulk MPQ packer (StormLib) for the WC3 classic set.
+// usage: wc3mpq <archive.mpq> <manifest.tsv>
+//   manifest lines: <src-path>\t<archive-name>   (archive names use backslashes)
+#include <cstdio>
+#include <cstring>
+#include <cstdlib>
+#include <sys/stat.h>
+#include "StormLib.h"
+
+int main(int argc, char **argv) {
+    if (argc < 3) {
+        fprintf(stderr, "usage: %s <archive.mpq> <manifest.tsv>\n", argv[0]);
+        return 2;
+    }
+    FILE *m = fopen(argv[2], "r");
+    if (!m) { perror("manifest"); return 2; }
+
+    long long n = 0;
+    char line[4096];
+    while (fgets(line, sizeof(line), m)) if (line[0] && line[0] != '#') n++;
+    rewind(m);
+    if (n == 0) { fprintf(stderr, "empty manifest\n"); return 2; }
+
+    HANDLE h = NULL;
+    if (!SFileCreateArchive(argv[1], MPQ_CREATE_ARCHIVE_V1 | MPQ_CREATE_LISTFILE | MPQ_CREATE_ATTRIBUTES,
+                            (DWORD)(n + 256), &h)) {
+        fprintf(stderr, "create failed: %u\n", SErrGetLastError());
+        return 1;
+    }
+    SFileSetMaxFileCount(h, (DWORD)(n + 8192));
+
+    long long ok = 0, fail = 0, bytes = 0;
+    while (fgets(line, sizeof(line), m)) {
+        if (!line[0] || line[0] == '#') continue;
+        char *tab = strchr(line, '\t');
+        if (!tab) continue;
+        *tab = '\0';
+        char *name = tab + 1;
+        size_t ln = strlen(name);
+        while (ln && (name[ln - 1] == '\n' || name[ln - 1] == '\r')) name[--ln] = '\0';
+        if (!ln) continue;
+
+        struct stat st;
+        int r;
+        if (stat(line, &st) == 0 && st.st_size > 0 && st.st_size < (32LL * 1024 * 1024)) {
+            r = SFileAddFileEx(h, line, name, MPQ_FILE_COMPRESS, MPQ_COMPRESSION_ZLIB, MPQ_COMPRESSION_NEXT_SAME);
+            bytes += st.st_size;
+        } else if (st.st_size > 0) {
+            r = SFileAddFileEx(h, line, name, 0, 0, 0);
+            bytes += st.st_size;
+        } else {
+            r = SFileAddFileEx(h, line, name, 0, 0, 0); /* zero-byte ok */
+        }
+        if (!r) {
+            fail++;
+            if (fail <= 25) fprintf(stderr, "add fail (%u): %s -> %s\n", SErrGetLastError(), line, name);
+        } else {
+            ok++;
+            if (ok % 2000 == 0) printf("  ... %lld files\n", ok);
+        }
+    }
+    fclose(m);
+
+    if (!SFileCloseArchive(h)) {
+        fprintf(stderr, "close failed: %u\n", SErrGetLastError());
+        return 1;
+    }
+    printf("packed ok=%lld fail=%lld src_bytes=%lld -> %s\n", ok, fail, bytes, argv[1]);
+    return fail ? 1 : 0;
+}
