+/* The browser game-setup screen relays the host's Start press as this string
+ * command; the server must only honor it from the lobby host. */
+TEST(server_net, lobby_start_match_is_host_gated) {
+    uint8_t msg_buf[512];
+    sizeBuf_t msg;
+    client_t *host;
+    client_t *guest;
+
+    reset_server_state(4);
+    sv.state = ss_lobby;
+    svs.num_clients = 2;
+    host = &svs.clients[0];
+    guest = &svs.clients[1];
+    host->state = cs_connected;
+    guest->state = cs_connected;
+    SZ_Init(&host->netchan.message, host->netchan.message_buf, MAX_MSGLEN);
+    SZ_Init(&guest->netchan.message, guest->netchan.message_buf, MAX_MSGLEN);
+    svs.lobby.active = true;
+    snprintf(svs.lobby.map_path, sizeof(svs.lobby.map_path), "Maps\\Melee\\Test.w3m");
+
+    /* Non-host request is ignored; the lobby keeps running. (SV_ExecuteUserCommand
+     * receives the message positioned at the string payload: the caller consumes
+     * the clc_stringcmd byte.) */
+    SZ_Init(&msg, msg_buf, sizeof(msg_buf));
+    MSG_WriteString(&msg, "lobby_start_match");
+    SV_ExecuteUserCommand(&msg, guest);
+    T_EQ(sv.state, ss_lobby);
+
+    /* Host request starts the match: SV_Map leaves the lobby state. */
+    SZ_Init(&msg, msg_buf, sizeof(msg_buf));
+    MSG_WriteString(&msg, "lobby_start_match");
+    SV_ExecuteUserCommand(&msg, host);
+    T_ASSERT(sv.state != ss_lobby);
+}
